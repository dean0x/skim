def calculate_sum(a, b) -> int:
    """Calculate sum of two numbers"""
    result = a + b
    return result

def greet_user(name) -> str:
    """Greet a user by name"""
    message = f"Hello, {name}!"
    return message

class Calculator:
    def add(x, y) -> int:
        return x + y

    def multiply(x, y) -> int:
        return x * y
